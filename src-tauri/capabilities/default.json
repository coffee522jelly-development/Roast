{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-main-commands",
    "opener:default",
    "dialog:default",
    "fs:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-remove"
  ]
}
